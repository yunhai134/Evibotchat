OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=C:/System_IT/Evibotchat/backend/models/bge-m3
EMBEDDING_CACHE_DIR=./models
HF_ENDPOINT=https://hf-mirror.com
KNOWLEDGE_DIRS=../激素和代谢性障碍_表格PDFs;../激素和代谢性障碍_PDFs;../精神健康障碍_PDFs;../精神健康障碍_表格PDFs
CHROMA_DIR=./chroma_db
COLLECTION_NAME=medical_books
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Huatuo-26M 问答对知识库
QA_COLLECTION_NAME=huatuo_qa
QA_RETRIEVAL_K=3
QA_SIMILARITY_THRESHOLD=0.55

# Rerank 重排序
RERANK_ENABLED=true
RERANK_MODEL=C:/System_IT/Evibotchat/backend/models/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RETRIEVAL_K=20
FINAL_K=5
